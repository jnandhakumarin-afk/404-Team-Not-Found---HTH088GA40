# AI Code Review & Release-Risk Assistant — Environment Configuration
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# PRIMARY AI PROVIDER — Google Gemini (free tier available)
# Get your key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# FALLBACK AI PROVIDER — Groq (free tier available)
# Get your key at: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL — Override default models
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# OPTIONAL — GitHub Personal Access Token (for higher API rate limits)
# Get a fine-grained or classic token at: https://github.com/settings/tokens
# ---------------------------------------------------------------------------
# The token is optional for public repositories (increases limit from 60 to 5,000 req/hr).
# It must NEVER be committed to version control or shared publicly.
# GITHUB_TOKEN=your_github_personal_access_token

# ---------------------------------------------------------------------------
# OPTIONAL — Backend URL for Streamlit (defaults to http://localhost:8000)
# ---------------------------------------------------------------------------
# BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Fallback behaviour (automatic — no configuration needed)
# ---------------------------------------------------------------------------
# If GEMINI_API_KEY is set and valid     -> Gemini is used as primary AI
# If Gemini fails, GROQ_API_KEY is set   -> Groq is used as fallback AI
# If both are unavailable                -> Static analysis only (no crash)
